{
  "name": "cellpinda-rhythm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:repo-privacy": "node scripts/validate-repo-privacy.mjs",
    "audit:history-privacy": "node scripts/audit-history-privacy.mjs",
    "dev": "node scripts/dev.mjs",
    "sync:data": "node scripts/sync-public-data.mjs",
    "audit:materials": "node scripts/audit-local-materials.mjs",
    "audit:orders": "node scripts/audit-local-orders.mjs",
    "preflight:deploy": "node scripts/check-deploy-readiness.mjs",
    "validate:goal": "node scripts/validate-goal-contract.mjs",
    "validate:plan": "node scripts/goal-next.mjs --check",
    "validate:research-copy": "node scripts/validate-research-copy.mjs",
    "validate:ui-contract": "node scripts/validate-ui-contract.mjs",
    "validate:teaser": "node scripts/validate-teaser-exposure.mjs",
    "validate:public": "node scripts/validate-public-export.mjs",
    "validate:artifacts": "node scripts/check-public-artifacts.mjs",
    "validate:static-bundle": "node scripts/validate-static-bundle.mjs",
    "validate:performance": "node scripts/validate-performance-budget.mjs",
    "generate:release-manifest": "node scripts/generate-release-manifest.mjs",
    "validate:release-manifest": "node scripts/validate-release-manifest.mjs",
    "validate:ops": "node scripts/validate-ops-mvp.mjs",
    "validate:tf-pulse": "node scripts/validate-tf-pulse.mjs",
