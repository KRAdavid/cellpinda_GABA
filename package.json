    "goal:next": "node scripts/goal-next.mjs",
    "tf:pulse": "node scripts/tf-pulse.mjs",
    "build": "pnpm run validate:repo-privacy && pnpm run generate:share-pages && pnpm run validate:goal && pnpm run validate:plan && pnpm run validate:research-copy && pnpm run validate:ui-contract && pnpm run validate:teaser && pnpm run validate:ops && pnpm run validate:tf-pulse && pnpm run validate:tf-pulse-workflow && pnpm run validate:deploy-workflow && pnpm run validate:daily-status-workflow && pnpm run sync:data && pnpm run validate:public && tsc -b && vite build && node scripts/rewrite-public-origin.mjs dist && pnpm run generate:release-manifest -- dist && pnpm run validate:release-manifest -- dist && pnpm run validate:artifacts && pnpm run validate:static-bundle -- dist && pnpm run validate:performance -- dist",
    "preview": "node scripts/preview.mjs",
    "server": "node server/index.mjs",
    "test": "node --test src/domain/rhythm.test.ts src/domain/fatigue-game.test.ts src/domain/breath-guide.test.ts src/domain/challenge.test.ts src/domain/share.test.ts src/domain/orders.test.ts src/domain/smartstore-orders.test.ts src/domain/reviews.test.ts src/domain/operations.test.ts src/domain/goal-mvp.test.ts src/domain/analytics-consent.test.ts src/domain/research-sources.test.ts scripts/local-api-runtime.test.mjs server/server.test.mjs worker/worker.test.mjs worker/social.test.mjs worker/members.test.mjs",
